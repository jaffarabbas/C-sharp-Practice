# Copy to .env (git-ignored) and replace every <placeholder>. Never commit real values.

# SQL Server used by the API container and the migrator.
# The API runs inside Docker, so "127.0.0.1" would point at the container itself. Use:
#   host.docker.internal,1433   - SQL Server running on the host / published by another container (default)
#   sqlserver,1433              - the optional "local-sql" compose profile (see README)
DB_CONNECTION_STRING=Server=host.docker.internal,1433;Database=<database>;User Id=<user>;Password=<password>;TrustServerCertificate=True;Encrypt=True;

# Seq admin password, applied on first start only (stored in the seq-data volume afterwards).
SEQ_ADMIN_PASSWORD=<choose-a-strong-password>
# Optional Seq ingestion API key (create it in Seq > Settings > API Keys). Empty = unauthenticated ingestion.
SEQ_API_KEY=

# Grafana admin credentials, applied on first start only.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<choose-a-strong-password>

# Only for `--profile local-sql` (containerized SQL Server on host port 14333).
LOCAL_SQL_SA_PASSWORD=<choose-a-strong-password>
