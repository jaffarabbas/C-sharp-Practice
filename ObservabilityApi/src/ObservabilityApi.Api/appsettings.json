{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Observability": {
    "ServiceName": "observability-api",
    "SlowRequestThresholdMs": 1000,
    "Console": { "Json": false },
    "Seq": {
      "ServerUrl": "",
      "QueueSizeLimit": 100000,
      "BatchPostingLimit": 1000,
      "PeriodSeconds": 2
    },
    "Otlp": { "Endpoint": "" },
    "Tracing": {
      "SamplingRatio": 1.0,
      "CaptureDbStatements": false
    },
    "Metrics": { "ExportIntervalSeconds": 15 }
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 10
  },
  "RequestTimeouts": { "DefaultTimeoutSeconds": 30 },
  "Cors": { "AllowedOrigins": [] },
  "Https": { "RedirectToHttps": false },
  "AllowedHosts": "*"
}
