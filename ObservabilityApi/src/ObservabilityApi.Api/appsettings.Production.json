{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Observability": {
    "Console": { "Json": true },
    "Tracing": { "SamplingRatio": 0.1 },
    "Metrics": { "ExportIntervalSeconds": 30 }
  },
  "OpenApi": { "Enabled": false },
  "Cors": { "AllowedOrigins": [] },
  "AllowedHosts": "*"
}
